<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@mipmap/ic_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="Ultimate Gamepad TV"
        android:theme="@style/Theme.UltimateGamepadTv">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".receiver.UdpReceiverService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />
        <!-- Receptor TCP (puerto 52000): lo arranca UdpReceiverService
             al iniciar. Sin esta declaración, startService() lo ignora
             en silencio (devuelve null sin error) y el TCP nunca
             escucha: el teléfono no puede conectar por TCP aunque la
             UI diga que está disponible. -->
        <service
            android:name=".receiver.TcpReceiverService"
            android:exported="false" />
        <!-- Proveedor de Shizuku: necesario para que Shizuku encuentre
             nuestro UserService. Sin él, bindUserService falla. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
