<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Ronda 2 P1: igual que en el teléfono: el receptor recibe
         datos continuamente; tipo dataSync (sin permiso BT en
         tiempo de ejecución). Antes connectedDevice. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- A4: igual que en el teléfono (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fase 5 (Bluetooth datos SPP/RFCOMM): imprescindibles en API 31+
         para listenUsingRfcommWithServiceRecord y leer el adapter.
         Sin uses-feature required: una TV sin BT debe seguir abriendo
         la app y decir "Sin Bluetooth en esta TV", no desaparecer. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@mipmap/ic_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="Ultimate Gamepad TV"
        android:theme="@style/Theme.UltimateGamepadTv">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".receiver.UdpReceiverService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- Receptor TCP (puerto 52000): lo arranca UdpReceiverService
             al iniciar. Sin esta declaración, startService() lo ignora
             en silencio (devuelve null sin error) y el TCP nunca
             escucha: el teléfono no puede conectar por TCP aunque la
             UI diga que está disponible. -->
        <service
            android:name=".receiver.TcpReceiverService"
            android:exported="false" />
        <!-- Receptor Bluetooth datos SPP/RFCOMM (Fase 5): lo arranca
             MainActivity junto al UDP. Sin esta declaración,
             startService() lo ignora en silencio y el BT nunca escucha. -->
        <service
            android:name=".receiver.BluetoothDataReceiverService"
            android:exported="false" />
        <!-- Proveedor de Shizuku: necesario para que Shizuku encuentre
             nuestro UserService. Sin él, bindUserService falla. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
